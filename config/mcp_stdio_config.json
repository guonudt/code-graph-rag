{
  "mcpServers": {
    "code-graph-rag": {
      "name": "Code Graph RAG (Local)",
      "type": "STDIO",
      "command": "uv",
      "args": [
        "--directory",
        "/Users/guoshuai/git/code-graph-rag",
        "run",
        "mcp_server.py",
        "stdio"
      ],
      "env": {
        "TARGET_REPO_PATH": "/Users/guoshuai/git/code-graph-rag",
        "MEMGRAPH_HOST": "localhost",
        "MEMGRAPH_PORT": "7687",
        "LOCAL_MODEL_ENDPOINT": "http://localhost:11434/v1",
        "LOCAL_ORCHESTRATOR_MODEL_ID": "llama3",
        "LOCAL_CYPHER_MODEL_ID": "llama3",
        "LOCAL_MODEL_API_KEY": "ollama"
      },
      "description": "Code Graph RAG MCP Server via STDIO transport"
    }
  }
}
